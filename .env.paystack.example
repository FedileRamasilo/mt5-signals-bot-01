# Copy these names into Railway Variables. Do not commit live keys.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_test_key
PAYSTACK_CURRENCY=ZAR
PAYSTACK_ENABLED=false
PAYSTACK_CALLBACK_URL=https://YOUR-RAILWAY-DOMAIN/paystack/return

# Set this to the exact database file path already used by your existing db.py.
# Do not change this blindly; existing deployments may use another path.
DATABASE_PATH=YOUR_EXISTING_SQLITE_DATABASE_PATH
