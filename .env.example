# --- Price data (TwelveData: free tier covers crypto, forex, and gold/XAU) ---
# Get a free key at https://twelvedata.com/pricing
TWELVEDATA_API_KEY=your_twelvedata_key_here

# --- Telegram ---
# Create a bot via @BotFather, get the token
TELEGRAM_BOT_TOKEN=your_bot_token_here
# The private channel/group ID where signals get posted (bot must be admin)
TELEGRAM_SIGNAL_CHANNEL_ID=-1001234567890
# A separate PUBLIC channel where one free proof-signal gets posted daily
# (create a second Telegram channel, set it to Public, add bot as admin)
TELEGRAM_FREE_CHANNEL_ID=-1009876543210
# Optional: a public invite link stub for new paying subscribers
TELEGRAM_CHANNEL_INVITE_LINK=https://t.me/+xxxxxxxxxxxx

# --- PayFast ---
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_passphrase
# Set to https://sandbox.payfast.co.za/eng/process for testing
PAYFAST_MODE=live

# --- Pricing (in ZAR cents avoided - use rand as float) ---
DAILY_PRICE=100
MONTHLY_PRICE=1500

# --- Email (SMTP - Gmail App Password, SendGrid SMTP relay, or Mailgun SMTP all work) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your_app_password_here
FROM_EMAIL=you@gmail.com
FROM_NAME=Market Signals

# --- App ---
FLASK_SECRET_KEY=change_me_to_something_random
DATABASE_PATH=subscribers.db

# --- Manual bank transfer (EFT) fallback - use this to launch before PayFast is fully working ---
BANK_NAME=FNB
BANK_ACCOUNT_HOLDER=Your Full Name
BANK_ACCOUNT_NUMBER=1234567890
BANK_BRANCH_CODE=250655
BANK_ACCOUNT_TYPE=Cheque/Current
# A secret only you know - required to approve manual payments. Make this long and random.
ADMIN_SECRET=change_me_to_a_long_random_secret

