# --- Price data (TwelveData: free tier covers crypto, forex, and gold/XAU) ---
# Get a free key at https://twelvedata.com/pricing
TWELVEDATA_API_KEY=your_twelvedata_key_here

# --- Telegram ---
# Create a bot via @BotFather, get the token
TELEGRAM_BOT_TOKEN=your_bot_token_here
# The private channel/group ID where signals get posted (bot must be admin)
TELEGRAM_SIGNAL_CHANNEL_ID=-1001234567890
# A separate PUBLIC channel where one free proof-signal gets posted daily
# (create a second Telegram channel, set it to Public, add bot as admin)
TELEGRAM_FREE_CHANNEL_ID=-1009876543210
# Optional: a public invite link stub for new paying subscribers
TELEGRAM_CHANNEL_INVITE_LINK=https://t.me/+xxxxxxxxxxxx

# --- PayFast ---
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_passphrase
# Set to https://sandbox.payfast.co.za/eng/process for testing
PAYFAST_MODE=live

# --- Pricing (in ZAR cents avoided - use rand as float) ---
# DAILY_PRICE is now per 12-HOUR period (not 24 hours) - subscribers pay twice a day
DAILY_PRICE=150
MONTHLY_PRICE=1500

# --- Email (Brevo HTTPS API - Railway and similar hosts block outbound SMTP on free/hobby plans) ---
# Sign up free at https://www.brevo.com, verify your account, then go to
# SMTP & API > API Keys to generate a key.
BREVO_API_KEY=your_brevo_api_key_here
FROM_EMAIL=you@gmail.com
FROM_NAME=Market Signals

# --- App ---
FLASK_SECRET_KEY=change_me_to_something_random
DATABASE_PATH=subscribers.db

# --- Manual bank transfer (EFT) fallback - use this to launch before PayFast is fully working ---
BANK_NAME=FNB
BANK_ACCOUNT_HOLDER=Your Full Name
BANK_ACCOUNT_NUMBER=1234567890
BANK_BRANCH_CODE=250655
BANK_ACCOUNT_TYPE=Cheque/Current
# A secret only you know - required to approve manual payments. Make this long and random.
ADMIN_SECRET=change_me_to_a_long_random_secret

# --- Hosting: keep data safe across redeploys ---
# In Railway add a Volume to the web service mounted at /data, then use:
# DATABASE_PATH=/data/subscribers.db
# (Without a volume, every redeploy wipes subscriber records and the track record.)
# The signal/expiry jobs now run inside the web service. Do NOT run a separate worker.
RUN_SCHEDULER=true

# Your own WhatsApp number (any format, e.g. 082 123 4567). Customers get a one-tap
# "send proof of payment" button on the bank-transfer page.
ADMIN_WHATSAPP=0821234567
# Email is no longer needed: links are sent by WhatsApp from the approve page.

# --- Paystack (card + instant payments, automatic access after payment) ---
# Leave blank to keep using bank transfer only. Start with your TEST key (sk_test_...),
# switch to the LIVE key (sk_live_...) once Paystack has activated your account.
# Paystack dashboard: Settings > API Keys & Webhooks. Set the webhook URL to:
#   https://YOUR-DOMAIN/paystack/webhook
PAYSTACK_SECRET_KEY=

# --- Subscriber website (/signup, /login, /signals) ---
# FLASK_SECRET_KEY (above) must be a long random value - it signs the login cookies.
# BREVO_API_KEY + FROM_EMAIL (above) send the sign-in links by email.
# A paid login works on this many devices at once (a newer device signs the oldest out):
MAX_DEVICES=2
